{
  "require_primary_backend": false,
  "consumer_rules": {
    "default": {
      "allow": ["generated", "infisical", "vault", "env"],
      "deny": []
    }
  },
  "trust_boundaries": {
    "high_assurance": {
      "require_primary_backend": true,
      "allow": ["infisical", "vault"],
      "deny": ["env"]
    },
    "development": {
      "allow": ["generated", "env", "infisical", "vault"],
      "deny": []
    }
  }
}
